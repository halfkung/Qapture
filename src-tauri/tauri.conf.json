{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qapture",
  "version": "0.2.0",
  "identifier": "app.qapture.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Qapture",
        "width": 920,
        "height": 740,
        "preventOverflow": true,
        "minWidth": 540,
        "minHeight": 500,
        "center": true,
        "visible": false
      },
      {
        "label": "editor",
        "create": false,
        "title": "Qapture — Quick editor",
        "url": "index.html?view=editor",
        "width": 1000,
        "height": 720,
        "minWidth": 620,
        "minHeight": 480,
        "center": true
      },
      {
        "label": "pin",
        "create": false,
        "title": "Qapture — Pinned image",
        "url": "index.html?view=pin",
        "alwaysOnTop": true,
        "preventOverflow": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
