{
  "identifier": "dashboard",
  "description": "Local dashboard capture and shortcut controls",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-dashboard-info",
    "allow-dashboard-ready",
    "allow-start-capture",
    "allow-cancel-capture",
    "allow-set-shortcut",
    "allow-recover-shortcut",
    "allow-set-shortcut-recording",
    "allow-output-preferences",
    "allow-set-output-preferences",
    "allow-list-projects",
    "allow-delete-project",
    "allow-clear-projects",
    "allow-reopen-project",
    "allow-import-image",
    "allow-startup-enabled",
    "allow-set-startup"
  ]
}
